# Copy this file to `.env` (same folder) and fill in values. `.env` is git-ignored.
#
# GitHub token (optional but strongly recommended).
#   Without a token GitHub allows 60 API requests/hour per IP; with one, 5,000/hour.
#   Create a *fine-grained* token: GitHub -> Settings -> Developer settings ->
#   Fine-grained tokens -> "Public repositories (read-only)". No extra permissions needed.
#   The token stays on the backend and is never sent to the browser.
GITHUB_TOKEN=

# Backend port (default 8080)
# PORT=8080

# Origins allowed to call the API from a browser (comma-separated).
# Not needed for local dev: the Vite dev server proxies /api to the backend.
# GITPULSE_CORS_ALLOWED_ORIGINS=http://localhost:5173
